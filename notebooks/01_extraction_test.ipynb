      "      \"reader_types\": [\"CARD\"],\n",
      "      \"description\": \"Overige binnendeuren met IN-only kaartlezers en elektrische sluitplaten\"\n",
      "    }\n",
      "  ],\n",
      "  \"controller_rules\": []\n",
      "}\n"
     ]
    }
